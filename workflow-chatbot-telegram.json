          "id": "HH8kwuAXPk36gAAf",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "01c2c8a6-c653-4ac8-b702-143f6b01ae56",
              "name": "queue",
              "value": "={{ (() => { const raw = String($json.message?.text ?? '').trim().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/\\s+/g, ' ').replace(/\\s*,\\s*/g, ',').toLowerCase(); const parts = raw.split(',').map(part => part.trim()).filter(Boolean); if (parts.length === 2) parts.push('br'); return parts.join(','); })() }}",
              "type": "string"
            },
            {
              "id": "87406565-5b13-4f7c-ae6d-aa8422519845",
              "name": "chat_id",
              "value": "={{ $json.message.chat.id }}",
              "type": "number"
            },
            {
              "id": "3ff95f29-b59a-49d5-9a63-0ae35ec0ff26",
              "name": "input_valid",
              "value": "={{ (() => { const parts = String($json.message?.text ?? '').trim().split(',').map(part => part.trim()).filter(Boolean); return (parts.length === 2 || parts.length === 3) && parts[0].length > 0 && /^[A-Za-z]{2}$/.test(parts[1]) && (parts.length === 2 || /^[A-Za-z]{2}$/.test(parts[2])); })() }}",
              "type": "boolean"
            },
            {
              "id": "cf356113-5075-47da-9489-c0678038ca89",
              "name": "message",
              "value": "❌ Cidade não encontrada. Use o formato Cidade,UF,BR (ex.: São Paulo,SP,BR).",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        432
      ],
      "id": "afd619f9-1041-4abe-94ee-29b19fb34557",
      "name": "Capturar e formatar entrada"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "78cbc1ee-d3b8-4b68-80f1-f4ccbd98ee61",
              "leftValue": "={{ $json.input_valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
