      "name": "Entrada válida?"
    },
    {
      "parameters": {
        "url": "https://api.openweathermap.org/data/2.5/weather",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.queue }}"
            },
            {
              "name": "units",
              "value": "metric"
            },
            {
              "name": "lang",
              "value": "pt_br"
            },
            {
              "name": "appid",
              "value": "={{ $env.OPENWEATHER_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 10000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        752,
        352
      ],
      "id": "a9d724f1-29b5-468a-8862-ee15b9b104aa",
      "name": "Consultar OpenWeather",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst source = $('Capturar e formatar entrada').first().json;\nconst body = response.body ?? {};\nconst statusCode = Number(response.statusCode ?? 0);\nconst temperature = Number(body?.main?.temp);\nconst city = typeof body?.name === 'string' ? body.name.trim() : '';\nconst ok = statusCode >= 200 && statusCode < 300 && city.length > 0 && Number.isFinite(temperature);\n\nreturn [{\n  json: {\n    chat_id: source.chat_id,\n    queue: source.queue,\n    status_code: statusCode,\n    ok,\n    message: ok\n      ? `🌤️ A temperatura em ${city} é de ${Math.round(temperature)}°C.`\n      : '❌ Cidade não encontrada. Use o formato Cidade,UF,BR (ex.: São Paulo,SP,BR).',\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        352
      ],
